  async function submitNoteWithPhotos(activityId) {
    if (!memberName) {
      openOnboardingModal();
      showModalAlert('⚠️ Vui lòng nhập Tên của bạn trước khi gửi Note hoặc tải ảnh lên kho chung nhé!', 'error');
      return;
    }

    const inp = document.getElementById(`inpNote_${activityId}`);
    const text = inp ? inp.value.trim() : '';
    const photosToUpload = pendingPhotosByAct[activityId] || [];

    if (!text && photosToUpload.length === 0) return;

    const btn = document.getElementById(`btnSend_${activityId}`);
    if (btn) {
      btn.disabled = true;
      btn.textContent = photosToUpload.length > 0 ? '⏳ Đang tải ảnh...' : '⏳...';
    }

    const localEntry = {
      author: memberName,
      time: new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }),
      text: text,
      photos: photosToUpload.map(p => ({ thumbUrl: p.base64, viewUrl: p.base64, downloadUrl: p.base64 }))
    };

    if (activityId === 'GENERAL') {
      if (!tripData.generalNotes) tripData.generalNotes = [];
      tripData.generalNotes.push(localEntry);
    } else {
      const act = (tripData.activities || []).find(a => a.id === activityId);
      if (act) {
        if (!act.notes) act.notes = [];
        act.notes.push(localEntry);
      }
    }

    ensureMemberInLocalList(memberName);
    if (inp) inp.value = '';
    pendingPhotosByAct[activityId] = [];
    saveLocalTrip();
    renderAllTimelineSections();

    const url = (document.getElementById('inpGasUrl').value.trim() || gasWebAppUrl).trim();
    if (url) {
      try {
        const res = await callGasBackend({
          action: 'addNoteAndPhotos',
          activityId: activityId,
          author: memberName,
          text: text,
          photos: photosToUpload,
          fallbackTripData: tripData
        });
        if (res && res.success && res.tripData) {
          tripData = res.tripData;
          saveLocalTrip();
          renderAllTimelineSections();
        }
      } catch (e) {
        alert('Lưu lên Drive gặp lỗi: ' + e.message);
      }
    }

    if (btn) {
      btn.disabled = false;
      btn.textContent = 'Gửi';
    }
  }

  // ==================== ĐỊNH VỊ THỜI GIAN THỰC & ĐỒNG HỒ COUNTDOWN ====================
  function getNowDate() {
    return isSimulatingTime ? new Date(simulatedTimeMs) : new Date();
  }

  function handleSliderSimulate(val) {
    if (!tripData.activities || tripData.activities.length === 0) return;
    isSimulatingTime = true;
    const sorted = [...tripData.activities].sort((a, b) => new Date(a.startTime) - new Date(b.startTime));
    const minMs = new Date(sorted[0].startTime).getTime() - 3 * 3600 * 1000;
    const maxMs = new Date(sorted[sorted.length - 1].endTime || sorted[sorted.length - 1].startTime).getTime() + 2 * 3600 * 1000;
    simulatedTimeMs = minMs + ((maxMs - minMs) * (Number(val) / 100));

    document.getElementById('simStatusLabel').textContent = 'Đang tua thử giờ';
    document.getElementById('simStatusLabel').style.color = '#d97706';
    renderAllTimelineSections();
    refreshWeatherAndNearbyForActiveAct();
  }

  function backToRealTime() {
    isSimulatingTime = false;
    document.getElementById('simStatusLabel').textContent = 'Thời gian thực';
    document.getElementById('simStatusLabel').style.color = '#059669';
    renderAllTimelineSections();
    refreshWeatherAndNearbyForActiveAct();
  }

  function partitionTimeline(now) {
    const sorted = [...(tripData.activities || [])].sort((a, b) => new Date(a.startTime) - new Date(b.startTime));
    const past = [];
    let ongoing = null;
    const upcoming = [];

    for (const act of sorted) {
      const start = new Date(act.startTime);
      const end = act.endTime ? new Date(act.endTime) : new Date(start.getTime() + 90 * 60000);

      if (now >= start && now <= end && !ongoing) {
        ongoing = act;
      } else if (end < now) {
        past.push(act);
      } else {
        upcoming.push(act);
      }
    }

    const focusAct = ongoing || upcoming[0] || past[past.length - 1] || null;
    return {
      past3to5: past.slice(-5).reverse(),
      ongoingAct: ongoing,
      nextNearestAct: upcoming[0] || null,
      upcoming3to5: upcoming.slice(0, 5),
      focusAct: focusAct
    };
  }

  function updateEverySecondTick() {
    const now = getNowDate();
    document.getElementById('liveClockText').textContent =
      now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' • ' +
      now.toLocaleDateString('vi-VN', { weekday: 'short', day: '2-digit', month: '2-digit' });

    const { ongoingAct, nextNearestAct } = partitionTimeline(now);
    const cdBanner = document.getElementById('countdownBanner');

    if (!ongoingAct && nextNearestAct) {
      const targetMs = new Date(nextNearestAct.startTime).getTime();
      const diffSec = Math.max(0, Math.floor((targetMs - now.getTime()) / 1000));

      const days = Math.floor(diffSec / 86400);
      const hours = Math.floor((diffSec % 86400) / 3600);
      const mins = Math.floor((diffSec % 3600) / 60);
      const secs = diffSec % 60;

      cdBanner.style.display = 'block';
      document.getElementById('countdownTargetTitle').textContent =
        `🎯 Sắp diễn ra: ${nextNearestAct.title} (${formatTimeHM(new Date(nextNearestAct.startTime))})`;
      document.getElementById('cdDays').textContent = String(days).padStart(2, '0');
      document.getElementById('cdHours').textContent = String(hours).padStart(2, '0');
      document.getElementById('cdMins').textContent = String(mins).padStart(2, '0');
      document.getElementById('cdSecs').textContent = String(secs).padStart(2, '0');
    } else {
      cdBanner.style.display = 'none';
    }
  }

