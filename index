  function buildActivityCardHtml(act, mode, now) {
    const start = new Date(act.startTime);
    const end = act.endTime ? new Date(act.endTime) : new Date(start.getTime() + 90 * 60000);
    const timeText = `${formatTimeHM(start)} – ${formatTimeHM(end)} (${start.getDate()}/${start.getMonth() + 1})`;

    let badgeRight = '';
    if (mode === 'now') {
      const minsLeft = Math.max(1, Math.round((end - now) / 60000));
      badgeRight = `<span style="background:#15803d;color:#fff;font-size:11px;font-weight:700;padding:3px 8px;border-radius:99px;">⚡ ĐANG DIỄN RA (Còn ${minsLeft}p)</span>`;
    } else if (mode === 'upcoming') {
      const waitMins = Math.max(1, Math.round((start - now) / 60000));
      const waitStr = waitMins >= 60 ? `Còn ${Math.floor(waitMins / 60)}h ${waitMins % 60}p` : `Còn ${waitMins} phút`;
      badgeRight = `<span style="background:#dbeafe;color:#1e40af;font-size:11px;font-weight:700;padding:3px 8px;border-radius:99px;">⏳ ${waitStr}</span>`;
    } else {
      badgeRight = `<span style="background:#e2e8f0;color:#475569;font-size:11px;font-weight:700;padding:3px 8px;border-radius:99px;">✓ Đã qua</span>`;
    }

    const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(act.locationName || act.title)}`;
    const notes = act.notes || [];
    const notesListHtml = notes.length > 0
      ? notes.map(n => renderNoteBubbleHtml(n)).join('')
      : `<div style="font-size:12px; color:#94a3b8; margin-bottom:4px;">Chưa có Note hoặc ảnh chụp nào tại chặng này.</div>`;

    return `
      <div class="act-card ${mode}">
        <div class="act-top">
          <span class="act-time-pill">🕒 ${timeText}</span>
          ${badgeRight}
        </div>
        <div class="act-name">${escapeHtml(act.title)}</div>
        <div class="act-place">
