  function compressPhotoFile(file, maxWidth = 1600, quality = 0.82) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          let w = img.width;
          let h = img.height;
          if (w > maxWidth) {
            h = Math.round((h * maxWidth) / w);
            w = maxWidth;
          }
          const canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          canvas.getContext('2d').drawImage(img, 0, 0, w, h);
          resolve({ base64: canvas.toDataURL('image/jpeg', quality) });
        };
        img.onerror = reject;
        img.src = e.target.result;
      };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  async function preparePhotosForNote(activityId, fileList) {
    if (!fileList || fileList.length === 0) return;
    if (!pendingPhotosByAct[activityId]) pendingPhotosByAct[activityId] = [];

    const stripEl = document.getElementById(`pendingPhotos_${activityId}`);
    if (stripEl) stripEl.innerHTML = `<span style="font-size:11.5px;color:#2563eb;">⏳ Đang chuẩn bị ${fileList.length} ảnh...</span>`;

    for (let i = 0; i < fileList.length; i++) {
      const compressed = await compressPhotoFile(fileList[i]);
      pendingPhotosByAct[activityId].push(compressed);
    }

    renderPendingPhotosStrip(activityId);
  }

  function renderPendingPhotosStrip(activityId) {
    const stripEl = document.getElementById(`pendingPhotos_${activityId}`);
    if (!stripEl) return;
    const list = pendingPhotosByAct[activityId] || [];
