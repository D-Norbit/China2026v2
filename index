  // ==================== THỜI TIẾT & ĐỊA ĐIỂM BÁN KÍNH 2KM ====================
  function initGeolocationAndWeather() {
    renderAllTimelineSections();
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          userCoords = { lat: pos.coords.latitude, lng: pos.coords.longitude };
          renderAllTimelineSections();
          refreshWeatherAndNearbyForActiveAct();
        },
        () => refreshWeatherAndNearbyForActiveAct(),
        { enableHighAccuracy: true, timeout: 6000 }
      );
    } else {
      refreshWeatherAndNearbyForActiveAct();
    }
  }

  async function refreshWeatherAndNearbyForActiveAct() {
    const { focusAct } = partitionTimeline(getNowDate());
    const lat = (focusAct && focusAct.lat) ? focusAct.lat : (userCoords ? userCoords.lat : 21.0285);
    const lng = (focusAct && focusAct.lng) ? focusAct.lng : (userCoords ? userCoords.lng : 105.8542);
    const placeName = focusAct ? focusAct.locationName : 'Vị trí hiện tại';

    document.getElementById('weatherPlaceLabel').textContent = placeName.slice(0, 24);
    document.getElementById('poiCenterLabel').textContent = `Quanh ${placeName.slice(0, 18)}`;

    fetchWeatherOpenMeteo(lat, lng);
    fetchOsmPlaces2Km(lat, lng);
  }

  async function fetchWeatherOpenMeteo(lat, lng) {
    try {
      const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lng}&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m&hourly=temperature_2m,precipitation_probability,weather_code&timezone=auto&forecast_days=2`;
      const res = await fetch(url);
      const data = await res.json();

      if (data && data.current) {
        document.getElementById('wNowTemp').textContent = `${Math.round(data.current.temperature_2m)}°C`;
        document.getElementById('wNowDesc').textContent = wmoText(data.current.weather_code);
        document.getElementById('wNowWind').textContent = `💨 Gió: ${Math.round(data.current.wind_speed_10m)} km/h`;
        document.getElementById('wNowHum').textContent = `💧 Ẩm: ${data.current.relative_humidity_2m}%`;
      }

      if (data && data.hourly && data.hourly.time) {
        const curHourPrefix = new Date().toISOString().slice(0, 13);
        let idx0 = data.hourly.time.findIndex(t => t.startsWith(curHourPrefix));
        if (idx0 === -1) idx0 = new Date().getHours();

        let html = '';
        for (let h = 1; h <= 5; h++) {
          const i = idx0 + h;
          if (i < data.hourly.time.length) {
            const hm = data.hourly.time[i].slice(11, 16);
            const t = Math.round(data.hourly.temperature_2m[i]);
            const rain = data.hourly.precipitation_probability ? data.hourly.precipitation_probability[i] : 0;
            const ico = wmoIcon(data.hourly.weather_code[i]);
            html += `
              <div class="hour-cell">
                <div>${hm}</div>
                <div style="font-size:17px;">${ico}</div>
                <b>${t}°C</b>
                <div style="color:#0284c7;font-size:10.5px;font-weight:700;">🌧️${rain}%</div>
              </div>
            `;
          }
        }
        document.getElementById('hourlyWeatherBox').innerHTML = html;
      }
    } catch (e) {}
  }

  function wmoText(c) {
    if (c === 0) return '☀️ Trời nắng đẹp, quang mây';
    if (c <= 3) return '⛅ Có mây mát mẻ';
    if (c <= 48) return '🌫️ Sương mù nhẹ';
    if (c <= 67) return '🌧️ Mưa nhỏ rải rác';
    if (c <= 82) return '🌧️ Mưa rào (Nhớ chuẩn bị ô/áo mưa)';
    return '⛈️ Có dông';
  }

  function wmoIcon(c) {
    if (c === 0) return '☀️';
    if (c <= 3) return '⛅';
    if (c <= 48) return '🌫️';
    if (c <= 82) return '🌧️';
    return '⛈️';
  }

  async function fetchOsmPlaces2Km(lat, lng) {
    try {
      const q = `[out:json][timeout:8];(node["amenity"~"restaurant|cafe"](around:2000,${lat},${lng});node["tourism"~"attraction|museum|viewpoint"](around:2000,${lat},${lng}););out body 30;`;
      const res = await fetch('https://overpass-api.de/api/interpreter', { method: 'POST', body: q });
      const data = await res.json();

      const f = [], c = [], s = [];
      (data.elements || []).forEach(el => {
        if (!el.tags || !el.tags.name) return;
        const dKm = calcDistKm(lat, lng, el.lat, el.lon);
        if (dKm > 2.0) return;
        const obj = {
          name: el.tags.name,
          desc: el.tags['addr:street'] ? `Đường ${el.tags['addr:street']}` : 'Địa điểm thực tế trên bản đồ (<2km)',
          distKm: Number(dKm.toFixed(2))
        };
        if (el.tags.amenity === 'cafe') c.push(obj);
        else if (el.tags.amenity === 'restaurant') f.push(obj);
        else s.push(obj);
      });

      osmNearbyCache = { food: f.slice(0, 5), cafe: c.slice(0, 5), sight: s.slice(0, 5) };
      renderPoiSection();
    } catch (e) {
      renderPoiSection();
    }
  }

  function switchPoiTab(tab, btn) {
    currentPoiTab = tab;
    document.querySelectorAll('.poi-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderPoiSection();
  }

  function renderPoiSection() {
    const box = document.getElementById('poiItemsBox');
    const { focusAct } = partitionTimeline(getNowDate());

    const aiList = (focusAct && focusAct.nearby2km && focusAct.nearby2km[currentPoiTab])
      ? focusAct.nearby2km[currentPoiTab]
      : [];
    const merged = [...aiList, ...(osmNearbyCache[currentPoiTab] || [])].slice(0, 7);

    if (merged.length === 0) {
      box.innerHTML = `<div style="padding:10px; font-size:12.5px; color:#64748b;">Đang tải các địa điểm thú vị trong bán kính 2km...</div>`;
      return;
    }

    box.innerHTML = merged.map(item => {
      const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(item.name)}`;
      return `
        <div class="poi-card">
          <div>
            <div class="poi-title">${escapeHtml(item.name)}</div>
            <div class="poi-sub">${escapeHtml(item.desc || '')}</div>
          </div>
          <div style="display:flex; align-items:center; gap:6px;">
            <span class="poi-km">${item.distKm ? item.distKm + ' km' : '≤ 2km'}</span>
            <a href="${mapUrl}" target="_blank" class="btn btn-secondary btn-sm">Chỉ đường</a>
          </div>
        </div>
      `;
    }).join('');
  }

