  <!-- Cầu nối Iframe dự phòng -->
  <iframe name="gas_sync_iframe" id="gasSyncIframe" style="display:none;"></iframe>
  <form id="gasSyncForm" method="POST" target="gas_sync_iframe" accept-charset="UTF-8" style="display:none;">
    <input type="hidden" name="payload" id="gasSyncPayload">
  </form>

<script>
  // =========================================================================
  // DÁN LINK GOOGLE APPS SCRIPT (/exec) CỦA BẠN VÀO ĐÂY TRƯỚC KHI ĐƯA LÊN GITHUB
  // =========================================================================
  const DEFAULT_GAS_WEBAPP_URL = 'https://script.google.com/macros/s/AKfycbyGMhZ3avWDIzkwyK9FgUDl6WX-ePGJXpc9UHVNfpvVLIdtjI_bvf84SBSVNnxcv_UxBA/exec';

  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

  let memberName = '';
  let gasWebAppUrl = DEFAULT_GAS_WEBAPP_URL;
  let userCoords = null;
  let isSimulatingTime = false;
  let simulatedTimeMs = Date.now();
  let currentPoiTab = 'food';
  let uploadedFilePayload = null;
  let lastSplitSummaryPlainText = '';

  const pendingPhotosByAct = {};
  let pendingReceiptPhotos = [];

  let tripData = {
    tripTitle: 'Chuyến Đi Nhóm',
    sharedFolderUrl: '',
    sharedSheetUrl: '',
    expenseSheetUrl: '',
    members: [],
    activities: [],
    generalNotes: [],
    expenses: []
  };

  let osmNearbyCache = { food: [], cafe: [], sight: [] };
  const iframeCallbacks = {};

  window.addEventListener('DOMContentLoaded', () => {
    loadLocalSettings();

    window.addEventListener('message', (e) => {
      const d = e.data;
      if (d && d.requestId && iframeCallbacks[d.requestId]) {
        clearTimeout(iframeCallbacks[d.requestId].timer);
        const resolve = iframeCallbacks[d.requestId].resolve;
        delete iframeCallbacks[d.requestId];
        resolve(d);
      }
    });

    if (!tripData.activities || tripData.activities.length === 0) {
      createDefaultSampleTrip();
    }

    if (!memberName) {
      openOnboardingModal();
    }

    initGeolocationAndWeather();

    setInterval(() => updateEverySecondTick(), 1000);
    setInterval(() => {
      if (!isSimulatingTime) renderAllTimelineSections();
    }, 30000);

    syncTripFromServer(true);
  });

  function loadLocalSettings() {
    try {
      memberName = localStorage.getItem('gt_member_name') || '';
      if (memberName) {
        document.getElementById('topMemberName').textContent = memberName;
        document.getElementById('inpMemberName').value = memberName;
      }
      const savedUrl = localStorage.getItem('gt_gas_url') || DEFAULT_GAS_WEBAPP_URL;
      if (savedUrl) {
        gasWebAppUrl = savedUrl;
        document.getElementById('inpGasUrl').value = savedUrl;
      }
      const savedTrip = localStorage.getItem('gt_trip_data_v5');
      if (savedTrip) {
        tripData = JSON.parse(savedTrip);
        if (!tripData.expenses) tripData.expenses = [];
        if (!tripData.members) tripData.members = [];
        updateSharedLinksUI();
      }
    } catch (e) {}
  }

  function saveLocalTrip() {
    try {
      localStorage.setItem('gt_trip_data_v5', JSON.stringify(tripData));
      updateSharedLinksUI();
    } catch (e) {}
  }

  function updateSharedLinksUI() {
    if (tripData.sharedFolderUrl) {
      document.getElementById('btnOpenSharedFolder').href = tripData.sharedFolderUrl;
    }
    if (tripData.sharedSheetUrl) {
      document.getElementById('btnOpenSharedSheet').href = tripData.sharedSheetUrl;
    }
    const expUrl = tripData.expenseSheetUrl || tripData.sharedSheetUrl;
    if (expUrl) {
      document.getElementById('btnOpenExpenseSheet').href = expUrl;
      document.getElementById('linkQuickSheetExpense').href = expUrl;
    }
  }

  async function callGasBackend(payloadObj) {
    const url = (document.getElementById('inpGasUrl').value.trim() || gasWebAppUrl).trim();
    if (!url) throw new Error('Chưa cấu hình đường link Google Apps Script (/exec).');

    if (window.location.protocol !== 'file:') {
      try {
        const res = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payloadObj)
        });
        if (res.ok) return await res.json();
      } catch (e) {}
    }

    return new Promise((resolve, reject) => {
      const reqId = 'r_' + Date.now() + '_' + Math.random().toString(36).slice(2);
      payloadObj.requestId = reqId;
      payloadObj.useIframe = true;
      const timer = setTimeout(() => {
        delete iframeCallbacks[reqId];
        reject(new Error('Quá thời gian kết nối Apps Script. Hãy kiểm tra link /exec.'));
      }, 60000);
      iframeCallbacks[reqId] = { resolve, timer };

      const form = document.getElementById('gasSyncForm');
      const inp = document.getElementById('gasSyncPayload');
      form.action = url;
      inp.value = JSON.stringify(payloadObj);
      form.submit();
    });
  }

  async function syncTripFromServer(silent = true) {
    const url = (document.getElementById('inpGasUrl').value.trim() || gasWebAppUrl).trim();
    if (!url) return;
    try {
      const res = await callGasBackend({ action: 'getTripData' });
      if (res && res.success) {
        if (res.tripData && Array.isArray(res.tripData.activities) && res.tripData.activities.length > 0) {
          tripData = res.tripData;
        }
        if (res.sharedFolderUrl) tripData.sharedFolderUrl = res.sharedFolderUrl;
        if (res.sharedSheetUrl) tripData.sharedSheetUrl = res.sharedSheetUrl;
        if (res.expenseSheetUrl) tripData.expenseSheetUrl = res.expenseSheetUrl;
        if (!tripData.expenses) tripData.expenses = [];
        if (!tripData.members) tripData.members = [];
        saveLocalTrip();
        renderAllTimelineSections();
        refreshWeatherAndNearbyForActiveAct();
      }
    } catch (e) {
      if (!silent) alert('Không thể đồng bộ từ máy chủ: ' + e.message);
    }
  }

  // ==================== TÍNH NĂNG 1: AI TỰ ĐỘNG ĐỌC HOÁ ĐƠN (OCR RECEIPT) ====================
  async function prepareReceiptPhotosAndOcr(fileList) {
    if (!fileList || fileList.length === 0) return;
    const strip = document.getElementById('pendingReceiptStrip');
    strip.innerHTML = `<span style="font-size:11.5px;color:#059669;">⏳ Đang nén ${fileList.length} ảnh hoá đơn...</span>`;

    for (let i = 0; i < fileList.length; i++) {
      const compressed = await compressPhotoFile(fileList[i], 1500, 0.82);
      pendingReceiptPhotos.push(compressed);
    }
    document.getElementById('expReceiptInput').value = '';
    renderPendingReceiptsUI();

    // Tự động gọi AI OCR đọc ảnh hoá đơn đầu tiên vừa chụp
    const url = (document.getElementById('inpGasUrl').value.trim() || gasWebAppUrl).trim();
    const banner = document.getElementById('ocrStatusBanner');
    if (!url || pendingReceiptPhotos.length === 0) return;

    banner.className = 'ocr-status-banner loading';
    banner.innerHTML = '✨ <b>AI đang đọc hoá đơn (OCR)...</b> Tự động trích xuất số tiền, ngoại tệ & món ăn...';

    try {
      const res = await callGasBackend({
        action: 'ocrReceipt',
        imageBase64: pendingReceiptPhotos[pendingReceiptPhotos.length - 1].base64
      });

      if (res && res.success && res.ocr) {
        const ocr = res.ocr;
        if (ocr.amount && Number(ocr.amount) > 0) {
          document.getElementById('expAmountInput').value = Number(ocr.amount);
        }
        if (ocr.currency) {
          const curSel = document.getElementById('expCurrencySelect');
          if (Array.from(curSel.options).some(o => o.value === ocr.currency)) {
            curSel.value = ocr.currency;
          }
        }
        if (ocr.category) {
          const catSel = document.getElementById('expCategorySelect');
          if (Array.from(catSel.options).some(o => o.value === ocr.category)) {
            catSel.value = ocr.category;
          }
        }
        if (ocr.note) {
          document.getElementById('expNoteInput').value = ocr.note;
        }
        banner.className = 'ocr-status-banner done';
        banner.innerHTML = `✅ <b>AI đã đọc xong hoá đơn:</b> ${Number(ocr.amount || 0).toLocaleString('vi-VN')} ${escapeHtml(ocr.currency || 'VND')} — <i>${escapeHtml(ocr.note || '')}</i>. Hãy kiểm tra và bấm <b>Lưu</b>!`;
      } else {
        throw new Error(res && res.error ? res.error : 'Không đọc được chữ trên hoá đơn');
      }
    } catch (err) {
      banner.className = 'ocr-status-banner err';
      banner.innerHTML = `⚠️ Chưa tự đọc được số tiền (${escapeHtml(err.message)}). Bạn có thể gõ số tiền thủ công ở dưới nhé.`;
    }
  }

  function renderPendingReceiptsUI() {
    const strip = document.getElementById('pendingReceiptStrip');
    if (pendingReceiptPhotos.length === 0) {
      strip.innerHTML = '';
      return;
    }
    strip.innerHTML = pendingReceiptPhotos.map((p, idx) => `
      <div style="position:relative;">
        <img src="${p.base64}" class="pending-thumb" style="border-color:#059669;">
        <button onclick="removePendingReceipt(${idx})" style="position:absolute;top:-5px;right:-5px;background:#ef4444;color:#fff;border:none;border-radius:50%;width:18px;height:18px;font-size:10px;cursor:pointer;">✕</button>
      </div>
    `).join('');
  }

  function removePendingReceipt(idx) {
    pendingReceiptPhotos.splice(idx, 1);
    renderPendingReceiptsUI();
    if (pendingReceiptPhotos.length === 0) {
      document.getElementById('ocrStatusBanner').style.display = 'none';
    }
  }

  async function submitGroupExpense() {
    if (!memberName) {
      openOnboardingModal();
      showModalAlert('⚠️ Vui lòng nhập Tên của bạn trước khi kê khai chi phí chung nhé!', 'error');
      return;
    }

    const category = document.getElementById('expCategorySelect').value;
    const amountRaw = document.getElementById('expAmountInput').value;
    const currency = document.getElementById('expCurrencySelect').value;
    const note = document.getElementById('expNoteInput').value.trim();

    const amount = parseFloat(amountRaw);
    if (isNaN(amount) || amount <= 0) {
      alert('Vui lòng nhập số tiền hợp lệ lớn hơn 0!');
      document.getElementById('expAmountInput').focus();
      return;
    }

    const btn = document.getElementById('btnSubmitExpense');
    btn.disabled = true;
    btn.textContent = pendingReceiptPhotos.length > 0 ? '⏳ Đang lưu Hoá đơn lên Drive...' : '⏳ Đang lưu...';

    const receiptsToSend = [...pendingReceiptPhotos];
    const localExpense = {
      id: 'exp_' + Date.now(),
      time: new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }),
      payer: memberName,
      category: category,
      note: note,
      amount: amount,
      currency: currency,
      receipts: receiptsToSend.map(r => ({ thumbUrl: r.base64, viewUrl: r.base64, downloadUrl: r.base64 }))
    };

    if (!tripData.expenses) tripData.expenses = [];
    tripData.expenses.unshift(localExpense);
    ensureMemberInLocalList(memberName);

    document.getElementById('expAmountInput').value = '';
    document.getElementById('expNoteInput').value = '';
    document.getElementById('ocrStatusBanner').style.display = 'none';
    pendingReceiptPhotos = [];
    renderPendingReceiptsUI();
    saveLocalTrip();
    renderExpensesSection();

    const url = (document.getElementById('inpGasUrl').value.trim() || gasWebAppUrl).trim();
    if (url) {
      try {
        const res = await callGasBackend({
          action: 'addExpense',
          payer: memberName,
          category: category,
          note: note,
          amount: amount,
          currency: currency,
          receiptPhotos: receiptsToSend,
          fallbackTripData: tripData
        });
        if (res && res.success && res.tripData) {
          tripData = res.tripData;
          saveLocalTrip();
          renderExpensesSection();
        }
      } catch (e) {
        alert('Lỗi đồng bộ chi phí lên Google Sheet: ' + e.message);
      }
    }

    btn.disabled = false;
    btn.textContent = '💾 Lưu Chi Phí & Hoá Đơn Lên Sheet Đoàn';
  }

  // ==================== TÍNH NĂNG 2: BẢNG CHIA TIỀN TỰ ĐỘNG (SPLIT BILL CUỐI CHUYẾN) ====================
  function toggleSplitBillPanel() {
    const box = document.getElementById('splitBillBox');
    box.classList.toggle('open');
    if (box.classList.contains('open')) {
      renderSplitBillCalculation();
    }
  }

  function ensureMemberInLocalList(name) {
    if (!name) return;
    const clean = name.trim();
    if (!clean) return;
    if (!Array.isArray(tripData.members)) tripData.members = [];
    if (!tripData.members.some(m => m.toLowerCase() === clean.toLowerCase())) {
      tripData.members.push(clean);
    }
  }

  // Tập hợp danh sách tất cả thành viên trong đoàn (từ danh sách members + người trả tiền + người ghi note)
  function getAllGroupMembers() {
    const map = new Map();
    const add = (n) => {
      if (!n) return;
      const c = n.trim().replace(/\s*\(Trưởng nhóm\)/i, '');
      if (!c || c === 'AI Trợ lý' || c === 'Khách') return;
      const key = c.toLowerCase();
      if (!map.has(key)) map.set(key, c);
    };

    (tripData.members || []).forEach(add);
    (tripData.expenses || []).forEach(e => add(e.payer));
    (tripData.activities || []).forEach(a => (a.notes || []).forEach(n => add(n.author)));
    if (memberName) add(memberName);

    const result = Array.from(map.values());
    tripData.members = result;
    return result;
  }

  async function addSplitMemberManual() {
    const inp = document.getElementById('newSplitMemberInp');
    const name = inp.value.trim();
    if (!name) return;
    ensureMemberInLocalList(name);
    inp.value = '';
    saveLocalTrip();
    renderSplitBillCalculation();

    const url = (document.getElementById('inpGasUrl').value.trim() || gasWebAppUrl).trim();
    if (url) {
      try {
        await callGasBackend({ action: 'updateMembers', members: tripData.members, fallbackTripData: tripData });
      } catch (e) {}
    }
  }

  async function removeSplitMember(idx) {
    if (!Array.isArray(tripData.members)) return;
    tripData.members.splice(idx, 1);
    saveLocalTrip();
    renderSplitBillCalculation();

    const url = (document.getElementById('inpGasUrl').value.trim() || gasWebAppUrl).trim();
    if (url) {
      try {
        await callGasBackend({ action: 'updateMembers', members: tripData.members, fallbackTripData: tripData });
      } catch (e) {}
    }
  }

  // Thuật toán tối ưu công nợ (Minimum Cash Flow Split Bill) theo từng đơn vị tiền tệ
  function renderSplitBillCalculation() {
    const members = getAllGroupMembers();
    document.getElementById('splitMemberCount').textContent = members.length;

    const chipsEl = document.getElementById('splitMembersChips');
    chipsEl.innerHTML = members.map((m, idx) => `
      <span class="member-chip">
        👤 ${escapeHtml(m)}
        <button onclick="removeSplitMember(${idx})" title="Bỏ thành viên này khỏi danh sách chia tiền">✕</button>
      </span>
    `).join('');

    const resultEl = document.getElementById('splitSettlementResult');
    const expenses = tripData.expenses || [];

    if (members.length === 0 || expenses.length === 0) {
      resultEl.innerHTML = `<div style="font-size:12px;color:#6b21a8;">Hãy thêm ít nhất 2 thành viên và 1 khoản chi phí để hệ thống tự chia tiền.</div>`;
      lastSplitSummaryPlainText = '';
      return;
    }

    // Gom nhóm chi phí theo từng loại tiền tệ (VND, USD, EUR...)
    const byCurrency = {};
    expenses.forEach(exp => {
      const cur = exp.currency || 'VND';
      if (!byCurrency[cur]) byCurrency[cur] = [];
      byCurrency[cur].push(exp);
    });

    let htmlOut = '';
    let textReportLines = [`📊 QUYẾT TOÁN CHI PHÍ: ${tripData.tripTitle} (${members.length} thành viên: ${members.join(', ')})`];

    Object.keys(byCurrency).forEach(cur => {
      const curList = byCurrency[cur];
      const paidByMember = {};
      members.forEach(m => { paidByMember[m] = 0; });

      let totalCur = 0;
      curList.forEach(e => {
        const amt = Number(e.amount) || 0;
        totalCur += amt;
        const matchedMember = members.find(m => m.toLowerCase() === (e.payer || '').trim().toLowerCase());
        if (matchedMember) {
          paidByMember[matchedMember] += amt;
        } else if (e.payer) {
          paidByMember[e.payer] = (paidByMember[e.payer] || 0) + amt;
        }
      });

      const allParticipants = Object.keys(paidByMember);
      const count = allParticipants.length;
      const sharePerPerson = totalCur / count;

      // Tính số dư từng người: Dương (+) là đã chi dư cần thu về, Âm (-) là cần chuyển trả thêm
      const debtors = [];
      const creditors = [];
      allParticipants.forEach(person => {
        const net = paidByMember[person] - sharePerPerson;
        if (net < -0.5) debtors.push({ person, amount: -net });
        else if (net > 0.5) creditors.push({ person, amount: net });
      });

      debtors.sort((a, b) => b.amount - a.amount);
      creditors.sort((a, b) => b.amount - a.amount);

      const transfers = [];
      let i = 0, j = 0;
      while (i < debtors.length && j < creditors.length) {
        const sendAmt = Math.min(debtors[i].amount, creditors[j].amount);
        if (sendAmt > 0.5) {
          const rounded = cur === 'VND' ? Math.round(sendAmt / 1000) * 1000 || Math.round(sendAmt) : Number(sendAmt.toFixed(2));
          transfers.push({
            from: debtors[i].person,
            to: creditors[j].person,
            amount: rounded
          });
        }
        debtors[i].amount -= sendAmt;
        creditors[j].amount -= sendAmt;
        if (debtors[i].amount <= 0.5) i++;
        if (creditors[j].amount <= 0.5) j++;
      }

      const fmt = (n) => (cur === 'VND' ? Math.round(n).toLocaleString('vi-VN') : Number(n.toFixed(2)).toLocaleString('vi-VN')) + ' ' + cur;

      textReportLines.push(`\n💰 [${cur}] Tổng cộng: ${fmt(totalCur)} | Bình quân: ${fmt(sharePerPerson)}/người`);
      allParticipants.forEach(p => {
        textReportLines.push(`  • ${p} đã chi: ${fmt(paidByMember[p])}`);
      });

      const paidDetailHtml = allParticipants.map(p =>
        `<span style="display:inline-block;margin-right:10px;font-size:11.5px;color:#334155;">• <b>${escapeHtml(p)}</b> đã trả: ${fmt(paidByMember[p])}</span>`
      ).join('');

      const transfersHtml = transfers.length > 0
        ? transfers.map(t => {
            textReportLines.push(`  👉 ${t.from} chuyển cho ${t.to}: ${fmt(t.amount)}`);
            return `
              <div class="transfer-row">
                <span>💸 <b>${escapeHtml(t.from)}</b> chuyển cho <b>${escapeHtml(t.to)}</b></span>
                <span>${fmt(t.amount)}</span>
              </div>
            `;
          }).join('')
        : `<div style="margin-top:6px;color:#059669;font-weight:700;">✅ Mọi người đã chi đều nhau!</div>`;

      htmlOut += `
        <div class="settlement-card">
          <div style="display:flex;justify-content:space-between;font-weight:800;color:#1e293b;margin-bottom:4px;">
            <span>Đơn vị: ${escapeHtml(cur)}</span>
            <span>Bình quân: ${fmt(sharePerPerson)} / người</span>
          </div>
          <div style="margin-bottom:6px;line-height:1.5;">${paidDetailHtml}</div>
          <div style="font-size:11.5px;font-weight:700;color:#475569;">Lệnh chuyển khoản tối ưu:</div>
          ${transfersHtml}
        </div>
      `;
    });

    resultEl.innerHTML = htmlOut;
    lastSplitSummaryPlainText = textReportLines.join('\n');
  }

