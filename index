  async function handleUploadItineraryFile(file) {
    if (!file) return;
    showModalAlert(`⏳ Đang đọc file <b>${escapeHtml(file.name)}</b>...`, 'info');
    const lower = file.name.toLowerCase();
    uploadedFilePayload = null;

    try {
      if (lower.endsWith('.docx')) {
        const buf = await file.arrayBuffer();
        const res = await mammoth.extractRawText({ arrayBuffer: buf });
        document.getElementById('inpRawItinerary').value = res.value.trim();
        showModalAlert(`✅ Đã đọc nội dung Word! Bấm <b>"🚀 AI Phân Tích & Cập Nhật Cho Nhóm"</b>.`, 'success');
      } else if (lower.endsWith('.txt') || lower.endsWith('.md')) {
        const txt = await file.text();
        document.getElementById('inpRawItinerary').value = txt.trim();
        showModalAlert(`✅ Đã nạp nội dung file! Bấm <b>"🚀 AI Phân Tích & Cập Nhật Cho Nhóm"</b>.`, 'success');
      } else if (lower.endsWith('.pdf') || file.type.startsWith('image/')) {
        if (lower.endsWith('.pdf')) {
          const buf = await file.arrayBuffer();
          const pdf = await pdfjsLib.getDocument({ data: buf }).promise;
          let txt = '';
          for (let p = 1; p <= pdf.numPages; p++) {
            const page = await pdf.getPage(p);
            const tc = await page.getTextContent();
            txt += tc.items.map(i => i.str).join(' ') + '\n';
          }
          if (txt.trim().length > 20) {
            document.getElementById('inpRawItinerary').value = txt.trim();
          }
        }
        const reader = new FileReader();
        reader.onload = (e) => {
          uploadedFilePayload = {
            base64: e.target.result,
            mimeType: file.type || 'application/pdf'
          };
          showModalAlert(`✅ Đã đính kèm file <b>${escapeHtml(file.name)}</b>! Bấm <b>"🚀 AI Phân Tích"</b>.`, 'success');
        };
        reader.readAsDataURL(file);
      }
    } catch (err) {
      showModalAlert(`❌ Lỗi đọc file: ${err.message}`, 'error');
    }
  }

  async function submitItineraryToAi() {
    const name = document.getElementById('inpMemberName').value.trim() || 'Thành viên';
    memberName = name;
    localStorage.setItem('gt_member_name', name);
    document.getElementById('topMemberName').textContent = name;

    const url = (document.getElementById('inpGasUrl').value.trim() || gasWebAppUrl).trim();
    if (!url) {
      showModalAlert('⚠️ Vui lòng dán đường link Google Apps Script (/exec) vào mục số 2!', 'error');
      return;
    }
    gasWebAppUrl = url;
    localStorage.setItem('gt_gas_url', url);

    const rawText = document.getElementById('inpRawItinerary').value.trim();
    if (!rawText && !uploadedFilePayload) {
      showModalAlert('⚠️ Vui lòng chọn file lịch trình hoặc dán văn bản lịch trình vào mục số 3!', 'error');
      return;
    }

    const btn = document.getElementById('btnRunAiAnalyze');
    btn.disabled = true;
    showModalAlert('⏳ AI đang phân tích lịch trình và đồng bộ Kho Ảnh, Sheet Note & Sheet Chi Phí cho đoàn...', 'info');

    try {
      const res = await callGasBackend({
        action: 'analyzeItinerary',
        uploaderName: memberName,
        rawText: rawText,
        fileBase64: uploadedFilePayload ? uploadedFilePayload.base64 : '',
        mimeType: uploadedFilePayload ? uploadedFilePayload.mimeType : ''
      });

      if (!res || !res.success || !res.tripData) {
        throw new Error(res ? res.error : 'Không nhận được kết quả từ AI');
      }

      tripData = res.tripData;
      saveLocalTrip();
      backToRealTime();
      showModalAlert(`✅ Đã tạo lịch trình gồm <b>${tripData.activities.length} hoạt động</b> kèm Sheet Chi Phí & Hoá Đơn chung!`, 'success');
      setTimeout(() => closeOnboardingModal(), 1000);
    } catch (err) {
      showModalAlert(`❌ Lỗi: ${err.message}`, 'error');
    } finally {
      btn.disabled = false;
    }
  }

